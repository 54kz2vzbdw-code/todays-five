# The interop and real-backend suites write down every list they create, the instant the row
# exists, so a crashed run leaves a list that can be named and deleted rather than an orphan.
# A list id *is* its secret, so those ledgers never belong in the repository.
tools/.realsync-created.txt
apple/tools/.interop-created.txt

# The App Store Connect API key. It lives outside the repository (`~/.private_keys/`) and uploads
# read it from there; these patterns are here so a stray copy can never be committed by accident.
*.p8
AuthKey_*.p8
