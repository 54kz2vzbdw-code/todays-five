<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Today's Five</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The only encryption in the app is the list's own: CryptoKit's AES-GCM over the person's
	     document, and HTTPS. Both are exempt, so this is NO and the upload never asks. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- A service worker does not run in a WKWebView unless its domain is app-bound, and the
	     offline story is the service worker. Declaring this also means a web view configured
	     without limitsNavigationsToAppBoundDomains loses script injection entirely, which is why
	     WebViewController sets that flag. -->
	<key>WKAppBoundDomains</key>
	<array>
		<string>54kz2vzbdw-code.github.io</string>
	</array>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<!-- 1.12 b405: YES so a connected screen can be a scene of its own (ExternalDisplay.swift). On an iPhone it
		     changes nothing else: there is only ever one window of the app. -->
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
			<!-- 1.12 b405: a connected screen (AirPlay to an Apple TV, or a cable) shows the list as the kitchen
			     display while the phone stays the remote (ExternalDisplay.swift). -->
			<key>UIWindowSceneSessionRoleExternalDisplayNonInteractive</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>External</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).ExternalDisplaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- The launch screen is the page's own first-paint colour and nothing else: a mark here would
	     flash and vanish, where a matching flat colour is invisible. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<false/>

	<!-- No analytics, no crash reporting, no tracking, and nothing collected. -->
	<key>NSPrivacyTracking</key>
	<false/>
</dict>
</plist>
