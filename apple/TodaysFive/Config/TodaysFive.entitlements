<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- §5. `?mode=developer` skips Apple's CDN cache in debug, so a change to the association file
	     is live immediately instead of after a wait. Needs the paid program: Associated Domains is
	     not available to a Personal Team. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:54kz2vzbdw-code.github.io</string>
	</array>
	<!-- 1.12 b405: the shelf the widgets read (WidgetShelf.swift): the device's look, which lists it holds by key,
	     Today's lines. No secret is in it; the links stay in the Keychain. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pricebrannen.todaysfive</string>
	</array>
	<!-- 1.12 b405: the vault's items are in the app's own access group, which is its application identifier; naming
	     it here changes nothing for the app (it stays the default, first in the list) and is the half of keychain
	     sharing the widget extension's entitlement matches. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.pricebrannen.todaysfive</string>
	</array>
</dict>
</plist>
