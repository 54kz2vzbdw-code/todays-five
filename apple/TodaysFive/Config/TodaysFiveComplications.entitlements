<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The complication reads the decrypted document the Watch app leaves here. No Keychain item
	     is in this group: the secrets stay in the Watch app, which is the only thing that syncs. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pricebrannen.todaysfive</string>
	</array>
</dict>
</plist>
