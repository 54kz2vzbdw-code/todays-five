<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The complication is a separate process and needs the list the Watch app holds. The secrets
	     never cross: the Keychain items stay the Watch app's, and what is shared is the decrypted
	     document the store already keeps on disk. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.pricebrannen.todaysfive</string>
	</array>
</dict>
</plist>
