<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Today's Five</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- The single-target watchOS app shape: WKApplication says this bundle *is* the app rather
	     than a WatchKit stub with an extension beside it. -->
	<key>WKApplication</key>
	<true/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>com.pricebrannen.todaysfive</string>
	<!-- The Watch talks to the server itself (PLAN-apple-phase3.md §2): it needs the phone to hand
	     it a link, and nothing after that. -->
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>

	<!-- The Add complication's `.widgetURL` is `todaysfive://add`, and WKApplicationDelegate has no
	     url-opening callback at all — the whole optional list was read — so SwiftUI's `onOpenURL` is
	     the door and this is what makes the scheme reach it. Without it the complication is inert and
	     nothing says so. The scheme carries no list and never will: it means "add a line", and which
	     list that is, is the Watch's own selection. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.pricebrannen.todaysfive.watchkitapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>todaysfive</string>
			</array>
		</dict>
	</array>

	<!-- The kits' type, bundled. Every face is the repo's own latin subset from fonts/*.woff2,
	     converted and instanced to the weights theme.js asks for by apple/tools/gen-watch-fonts.py.
	     watchOS reads this key at process start and registers each file; no registration code runs.
	     The family names to ask Font.custom for are NOT the names in theme.js — those are the fiction
	     styles.css's @font-face rules invent, and ten of them resolve to Helvetica here. The real ones
	     are in test/fixtures/watch-fonts.json, read out of these very files, and -TFFontSelfTest is
	     what says every one of them resolved rather than falling back in silence. -->
	<key>UIAppFonts</key>
	<array>
		<string>archivo-500.ttf</string>
		<string>archivo-800.ttf</string>
		<string>baloo-2-700.ttf</string>
		<string>cormorant-garamond-700.ttf</string>
		<string>dm-sans-400.ttf</string>
		<string>dm-sans-700.ttf</string>
		<string>dm-serif-display-400.ttf</string>
		<string>fraunces-600.ttf</string>
		<string>fredoka-600.ttf</string>
		<string>ibm-plex-mono-400.ttf</string>
		<string>ibm-plex-mono-600.ttf</string>
		<string>ibm-plex-sans-400.ttf</string>
		<string>ibm-plex-sans-600.ttf</string>
		<string>jetbrains-mono-800.ttf</string>
		<string>josefin-sans-400.ttf</string>
		<string>josefin-sans-700.ttf</string>
		<string>karla-400.ttf</string>
		<string>karla-700.ttf</string>
		<string>lato-900.ttf</string>
		<string>lora-700.ttf</string>
		<string>manrope-500.ttf</string>
		<string>manrope-800.ttf</string>
		<string>nunito-sans-400.ttf</string>
		<string>nunito-sans-700.ttf</string>
		<string>outfit-800.ttf</string>
		<string>playfair-display-800.ttf</string>
		<string>pt-sans-400.ttf</string>
		<string>pt-sans-700.ttf</string>
		<string>quicksand-500.ttf</string>
		<string>quicksand-700.ttf</string>
		<string>source-serif-4-400.ttf</string>
		<string>source-serif-4-600.ttf</string>
		<string>space-grotesk-700.ttf</string>
	</array>

	<!-- The only encryption is the list's own: AES-GCM over the person's document, and HTTPS. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- No analytics, no crash reporting, no tracking, and nothing collected. -->
	<key>NSPrivacyTracking</key>
	<false/>
</dict>
</plist>
